{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syride-analyse.pages.dev/schema/v1.json",
  "title": "Contrat de données de la webapp « Analyse traces de vol », version 1",
  "description": "Source unique du contrat (ROADMAP_WEBAPP.md §4). L'export Python est validé contre ce schéma (jsonschema) et les types TypeScript en sont générés (json-schema-to-typescript). Règle D12 : aucune géométrie de vol (ni trace, ni coordonnée par vol). Valider un fichier avec {\"$ref\": \"…#/$defs/<Fichier>\"}.",
  "$defs": {
    "SchemaVersion": { "const": 1 },
    "Date": {
      "type": "string",
      "pattern": "^(19[89]\\d|20\\d{2})-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$",
      "description": "Date ISO AAAA-MM-JJ (1980 ou après : la date sentinelle 1901 est refusée)."
    },
    "Time": {
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
      "description": "Heure de décollage HH:MM."
    },
    "Slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Identifiant d'URL : minuscules ASCII, chiffres, tirets (accents translittérés)."
    },
    "FlightKey": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*-\\d+$",
      "description": "Clé stable d'un vol : \"<pilote_slug>-<num_activite>\", utilisée dans /vol/:key."
    },
    "Index": { "type": "integer", "minimum": 0, "description": "Index dans la liste correspondante de FlightsFile.dict." },
    "NullableIndex": { "type": ["integer", "null"], "minimum": 0 },
    "PositiveMeasure": {
      "type": ["number", "null"],
      "exclusiveMinimum": 0,
      "description": "Mesure strictement positive, ou null si inconnue. Les valeurs ≤ 0 du pkl sont exportées en null : c'est équivalent à la règle `_positive` du rapport et de l'app (moyennes, max, sommes et « vols mesurés » ignorent les valeurs ≤ 0)."
    },
    "Discipline": { "enum": ["parapente", "paramoteur"] },
    "DisciplineFilter": { "enum": ["tout", "parapente", "paramoteur"] },

    "MetaFile": {
      "title": "data/meta.json",
      "description": "Petit fichier d'amorce, jamais mis en cache (Cache-Control: no-cache). Donne les noms hashés des autres fichiers.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "generated_at", "data_updated_at", "data_refreshed_at", "counts", "files", "insights"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "generated_at": { "type": "string", "format": "date-time", "description": "Horodatage UTC de l'export." },
        "data_updated_at": { "$ref": "#/$defs/Date", "description": "Date du vol le plus récent exporté (référence des calculs « à date »)." },
        "data_refreshed_at": { "$ref": "#/$defs/Date", "description": "Date de la dernière mise à jour des données (max de date_update du pkl, comme le rapport) ; repli : date du dernier vol." },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["flights", "pilots", "sites", "wings", "excluded_flights"],
          "properties": {
            "flights": { "type": "integer", "minimum": 0 },
            "pilots": { "type": "integer", "minimum": 0 },
            "sites": { "type": "integer", "minimum": 0 },
            "wings": { "type": "integer", "minimum": 0 },
            "excluded_flights": { "type": "integer", "minimum": 0, "description": "Vols du pkl écartés de l'export (ex. date sentinelle 1901), affichés dans « Qualité des données »." }
          }
        },
        "files": {
          "type": "object",
          "additionalProperties": false,
          "required": ["flights", "sites"],
          "properties": {
            "flights": { "type": "string", "pattern": "^flights\\.[0-9a-f]{6,}\\.json$" },
            "sites": { "type": "string", "pattern": "^sites\\.[0-9a-f]{6,}\\.json$" }
          }
        },
        "insights": {
          "type": "array",
          "description": "Couples (pilote, année) pour lesquels un fichier insights/<pilote_slug>-<année>.json existe.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pilot", "year", "file"],
            "properties": {
              "pilot": { "$ref": "#/$defs/Slug" },
              "year": { "type": "integer", "minimum": 2000, "maximum": 2100 },
              "file": { "type": "string", "pattern": "^insights/[a-z0-9-]+-\\d{4}\\.[0-9a-f]{6,}\\.json$" }
            }
          }
        }
      }
    },

    "FlightsFile": {
      "title": "data/flights.<hash>.json (format colonnaire)",
      "description": "Une ligne par vol, dans l'ordre de `columns`. La clé d'un vol (FlightKey, URL /vol/:key) n'est pas exportée : le front la recalcule = pilot_slugs[pilot] + \"-\" + syride_num (gain ≈ 30 Ko gzip). Les catégories sont des index dans `dict`. Champs dérivés (année, mois, jour, saison, heure entière) non exportés : recalculés côté front depuis `date` et `time`.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "columns", "dict", "pilot_slugs", "rows"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "columns": {
          "const": ["pilot", "activity", "date", "time", "site", "wing", "instrument", "mode",
                    "duration_min", "dist_km", "dist_cum_km", "speed_avg", "speed_max", "ceiling_m", "gain_m",
                    "vario_max", "g_max", "incomplete", "source", "syride_num"]
        },
        "dict": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pilot", "activity", "site", "wing", "instrument", "mode", "source"],
          "properties": {
            "pilot": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true, "description": "Pseudo Syride exact (sert à construire les liens syride.com)." },
            "activity": { "const": ["parapente", "paramoteur"] },
            "site": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true, "description": "L'index d'un site est aussi son `id` dans sites.json." },
            "wing": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
            "instrument": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
            "mode": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true, "description": "Libellés courts de `mode_of` (report_data.py) : Site, Treuil, Rando, Bord de mer, Moteur, puis éventuels inconnus." },
            "source": { "const": ["gpx", "fiche", "aucune"] }
          }
        },
        "pilot_slugs": {
          "type": "array",
          "items": { "$ref": "#/$defs/Slug" },
          "uniqueItems": true,
          "description": "Aligné sur dict.pilot : slug d'URL du pilote (calculé une seule fois, en Python)."
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 20,
            "maxItems": 20,
            "prefixItems": [
              { "$ref": "#/$defs/Index", "description": "pilot" },
              { "$ref": "#/$defs/Index", "description": "activity" },
              { "oneOf": [{ "$ref": "#/$defs/Date" }, { "type": "null" }], "description": "date (null si inconnue, jamais 1901)" },
              { "oneOf": [{ "$ref": "#/$defs/Time" }, { "type": "null" }], "description": "time" },
              { "$ref": "#/$defs/NullableIndex", "description": "site" },
              { "$ref": "#/$defs/NullableIndex", "description": "wing" },
              { "$ref": "#/$defs/NullableIndex", "description": "instrument" },
              { "$ref": "#/$defs/NullableIndex", "description": "mode" },
              { "type": ["number", "null"], "minimum": 0, "description": "duration_min (minutes, 4 décimales : secondes entières à 0,003 s près)" },
              { "$ref": "#/$defs/PositiveMeasure", "description": "dist_km : colonne `distance`, référence (1 décimale)" },
              { "$ref": "#/$defs/PositiveMeasure", "description": "dist_cum_km : `distance_cumulee` (1 décimale)" },
              { "$ref": "#/$defs/PositiveMeasure", "description": "speed_avg km/h (1 décimale)" },
              { "$ref": "#/$defs/PositiveMeasure", "description": "speed_max km/h (1 décimale)" },
              { "$ref": "#/$defs/PositiveMeasure", "description": "ceiling_m : plafond (entier)" },
              { "$ref": "#/$defs/PositiveMeasure", "description": "gain_m (entier)" },
              { "$ref": "#/$defs/PositiveMeasure", "description": "vario_max m/s (1 décimale)" },
              { "$ref": "#/$defs/PositiveMeasure", "description": "g_max (1 décimale)" },
              { "type": "boolean", "description": "incomplete" },
              { "$ref": "#/$defs/Index", "description": "source des stats : index dans dict.source" },
              { "type": "integer", "minimum": 1, "description": "syride_num = num_activite (toujours renseigné) ; clé du vol = pilot_slugs[pilot] + \"-\" + syride_num ; lien https://www.syride.com/fr/pilotes/<pseudo>/<num>" }
            ]
          }
        }
      }
    },

    "SitesFile": {
      "title": "data/sites.<hash>.json",
      "description": "Un objet par site, `id` = index dans FlightsFile.dict.site. Coordonnées = moyenne du site (jamais celles d'un vol). Clé vide de sites_coordinates.json exclue.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "sites"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "sites": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "lat", "lon", "flights", "pilots", "activities"],
            "properties": {
              "id": { "$ref": "#/$defs/Index" },
              "name": { "type": "string", "minLength": 1 },
              "lat": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
              "lon": { "type": ["number", "null"], "minimum": -180, "maximum": 180 },
              "flights": { "type": "integer", "minimum": 0 },
              "pilots": { "type": "integer", "minimum": 0 },
              "activities": {
                "type": "object",
                "additionalProperties": false,
                "required": ["parapente", "paramoteur"],
                "properties": {
                  "parapente": { "type": "integer", "minimum": 0 },
                  "paramoteur": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        }
      }
    },

    "InsightsFile": {
      "title": "data/insights/<pilote_slug>-<année>.<hash>.json",
      "description": "Récit précalculé par src/web_export/insights.py en appelant src/rapport/report_data.py et le moteur de textes du rapport (report_textes.md, tirage crc32). Textes déjà rendus, en texte brut (espaces insécables conservés). `v` versionne ce fichier. Aucune coordonnée de vol : seules les zones de carte portent l'emprise des sites.",
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "pilot", "year", "cutoff", "by_disc"],
      "properties": {
        "v": { "const": 1 },
        "pilot": { "$ref": "#/$defs/Slug" },
        "year": { "type": "integer", "minimum": 1980, "maximum": 2100 },
        "cutoff": { "$ref": "#/$defs/Date", "description": "Date de fin effective du récit : le jour de l'export pour l'année en cours, le 31 décembre pour une année passée." },
        "by_disc": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tout", "parapente", "paramoteur"],
          "properties": {
            "tout": { "$ref": "#/$defs/Story" },
            "parapente": { "$ref": "#/$defs/Story" },
            "paramoteur": { "$ref": "#/$defs/Story" }
          }
        }
      }
    },

    "FlightRef": { "oneOf": [{ "$ref": "#/$defs/FlightKey" }, { "type": "null" }] },

    "PersonaKey": {
      "enum": ["debut", "libre", "polyvalent", "treuilleur", "marcheur", "plafond", "explorateur", "nomade", "marathonien", "regulier", "leve_tot", "soir", "fidele", "week_end"],
      "description": "Étiquette du portrait (clés de PERSONA_RULES, plus « debut » sous 5 vols et « libre » sans règle applicable)."
    },

    "Story": {
      "description": "Récit d'une discipline pour un pilote et une année ; null si le pilote n'a aucun vol dans cette discipline cette année. Textes en texte brut, identiques à ceux du rapport HTML.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["persona", "gap", "milestones", "records_beaten", "equivalences", "new_sites", "new_wings", "map_zones", "reach", "texts"],
          "properties": {
            "persona": {
              "description": "Portrait du pilote (page du bilan uniquement, D11) ; null si le texte est absent.",
              "oneOf": [{ "type": "null" }, {
                "type": "object",
                "additionalProperties": false,
                "required": ["main", "secondary", "label", "why"],
                "properties": {
                  "main": { "$ref": "#/$defs/PersonaKey" },
                  "secondary": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["key", "label", "why"],
                      "properties": {
                        "key": { "$ref": "#/$defs/PersonaKey" },
                        "label": { "type": "string" },
                        "why": { "type": "string" }
                      }
                    }
                  },
                  "label": { "type": "string" },
                  "why": { "type": "string", "description": "Justification ; chaîne vide si le texte n'en a pas." }
                }
              }]
            },
            "gap": {
              "description": "Avance ou retard sur l'année précédente (à date si l'année est en cours) ; null sans année de comparaison.",
              "oneOf": [{ "type": "null" }, {
                "type": "object",
                "additionalProperties": false,
                "required": ["status", "ref_year", "ongoing", "minutes", "flights", "text", "note"],
                "properties": {
                  "status": { "enum": ["avance", "retard", "egal"] },
                  "ref_year": { "type": "integer" },
                  "ongoing": { "type": "boolean" },
                  "minutes": { "type": "number", "minimum": 0, "description": "Écart absolu en minutes de vol." },
                  "flights": { "type": "integer", "description": "Écart signé en nombre de vols." },
                  "text": { "type": "string" },
                  "note": { "type": "string" }
                }
              }]
            },
            "milestones": {
              "type": "array",
              "description": "Jalons de l'année, triés par date, au plus 12.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["date", "kind", "value", "gold", "title", "detail", "flight"],
                "properties": {
                  "date": { "$ref": "#/$defs/Date" },
                  "kind": { "enum": ["first", "nth_flight", "nth_hour", "record", "best_day", "new_site", "new_wing", "comeback"] },
                  "value": { "type": ["integer", "null"], "description": "Palier (n-ième vol ou heure) pour nth_flight et nth_hour, sinon null." },
                  "gold": { "type": "boolean", "description": "Or = records et nouveautés uniquement." },
                  "title": { "type": "string" },
                  "detail": { "type": "string", "description": "Détail en une ligne (sites, durées, valeurs) ; chaîne vide s'il n'y en a pas." },
                  "flight": { "$ref": "#/$defs/FlightRef" },
                  "metrics": {
                    "type": "array",
                    "description": "Records du vol cité (jalons « record » et « first »).",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["metric", "value"],
                      "properties": {
                        "metric": { "enum": ["duree", "plafond", "distance"] },
                        "value": { "type": "number" }
                      }
                    }
                  }
                }
              }
            },
            "records_beaten": {
              "type": "array",
              "description": "Records personnels battus contre tout l'historique du pilote.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["metric", "value", "previous", "previous_year", "date", "flight"],
                "properties": {
                  "metric": { "enum": ["plafond", "vitesse_max", "distance", "vario", "g", "duree"] },
                  "value": { "type": "number" },
                  "previous": { "type": "number" },
                  "previous_year": { "type": "integer" },
                  "date": { "$ref": "#/$defs/Date" },
                  "flight": { "$ref": "#/$defs/FlightRef" }
                }
              }
            },
            "equivalences": { "type": "array", "items": { "type": "string" } },
            "new_sites": {
              "type": "array",
              "description": "Sites jamais volés les années précédentes, triés par date de découverte.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["site", "first_date", "n"],
                "properties": {
                  "site": { "type": "string" },
                  "first_date": { "$ref": "#/$defs/Date" },
                  "n": { "type": "integer", "minimum": 1 }
                }
              }
            },
            "new_wings": {
              "type": "array",
              "description": "Voiles jamais utilisées les années précédentes, triées par date.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["wing", "first_date"],
                "properties": {
                  "wing": { "type": "string" },
                  "first_date": { "$ref": "#/$defs/Date" }
                }
              }
            },
            "map_zones": {
              "type": "array",
              "description": "Zones de la carte, de la plus volée à la moins volée.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "top", "sites", "flights", "minutes", "bbox"],
                "properties": {
                  "name": { "type": "string", "description": "« Autour de <site le plus volé> »." },
                  "top": { "type": "string" },
                  "sites": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
                  "flights": { "type": "integer", "minimum": 1 },
                  "minutes": { "type": "number", "minimum": 0 },
                  "bbox": {
                    "type": "array",
                    "items": { "type": "number" },
                    "minItems": 4,
                    "maxItems": 4,
                    "description": "[lon_min, lat_min, lon_max, lat_max] des positions moyennes des sites de la zone (jamais d'un vol)."
                  }
                }
              }
            },
            "reach": {
              "description": "Portée autour du site principal ; null avec un seul site.",
              "oneOf": [{ "type": "null" }, {
                "type": "object",
                "additionalProperties": false,
                "required": ["main_site", "farthest_site", "km", "main_share"],
                "properties": {
                  "main_site": { "type": "string" },
                  "farthest_site": { "type": ["string", "null"], "description": "null si les sites n'ont pas de position." },
                  "km": { "type": ["number", "null"], "minimum": 0 },
                  "main_share": { "type": "number", "minimum": 0, "maximum": 1, "description": "Part des vols sur le site principal." }
                }
              }]
            },
            "texts": {
              "type": "object",
              "description": "Phrases du rapport (aperçu, histoire, faits marquants) ; null si la phrase n'a pas lieu d'être.",
              "additionalProperties": false,
              "required": ["synthese", "rythme", "quand", "ou", "matos", "records", "meilleure_journee", "journee_type"],
              "properties": {
                "synthese": { "type": ["string", "null"] },
                "rythme": { "type": ["string", "null"] },
                "quand": { "type": ["string", "null"] },
                "ou": { "type": ["string", "null"] },
                "matos": { "type": ["string", "null"] },
                "records": { "type": ["string", "null"] },
                "meilleure_journee": { "type": ["string", "null"] },
                "journee_type": { "type": ["string", "null"] }
              }
            }
          }
        }
      ]
    }
  }
}
