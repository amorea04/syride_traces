# Cloudflare Pages : en-têtes. Les règles qui se recoupent sont cumulées ; « ! » détache un en-tête hérité.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tiles.openfreemap.org; font-src 'self' data: https://tiles.openfreemap.org; connect-src 'self' https://tiles.openfreemap.org; worker-src 'self' blob:; child-src blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Fichiers compilés : nom hashé, donc immuables.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Données : noms hashés (immuables), sauf meta.json qui désigne les fichiers courants.
/data/*
  Cache-Control: public, max-age=31536000, immutable

/data/meta.json
  ! Cache-Control
  Cache-Control: no-cache

# Service worker et sa logique : toujours revalidés, pour que les mises à jour arrivent.
/sw.js
  Cache-Control: no-cache

/sw-routing.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache
