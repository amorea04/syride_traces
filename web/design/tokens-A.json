    },
    "y1": {
      "dasharray": "7 4",
      "hatch": "diagonal 45°"
    },
    "y2": {
      "dasharray": "2 4",
      "hatch": "diagonal 135°"
    },
    "hatch_width": 2,
    "hatch_gap": 5
