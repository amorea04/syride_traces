  "shadow": {
    "light": {
      "sm": "0 1px 2px rgba(15,23,42,.05)",
      "md": "0 1px 2px rgba(15,23,42,.05), 0 10px 30px rgba(15,23,42,.07)"
    },
    "dark": {
      "sm": "0 1px 2px rgba(0,0,0,.4)",
      "md": "0 1px 2px rgba(0,0,0,.4), 0 10px 30px rgba(0,0,0,.35)"
    }
  },
