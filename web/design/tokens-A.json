    "numeric": "tabular-nums"
  },
  "type": {
    "xs": 12,
    "sm": 13,
    "base": 15,
    "md": 17,
    "lg": 20,
    "xl": 26,
    "2xl": 34,
    "3xl": 46,
    "unit": "px",
    "line_height": {
      "tight": 1.15,
      "base": 1.5,
      "loose": 1.65
    }
  },
  "weight": {
    "regular": 400,
    "medium": 500,
    "semibold": 650,
    "bold": 800
  },
  "tracking": {
    "display": "-.03em",
    "heading": "-.02em",
    "label": ".12em"
  },
  "motion": {
    "duration_ms": 150,
    "easing": "ease-out",
    "decorative_animation": false
